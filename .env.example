# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pokémon TCG API (https://pokemontcg.io) — optional but raises the rate
# limit for syncing set data. Get a free key at https://dev.pokemontcg.io
POKEMON_TCG_API_KEY=

# Shared secret checked by /api/cron/sync-sets and /api/cron/sync-news so
# only Vercel Cron (or you) can trigger them. Optional locally; set it in
# Vercel for production.
CRON_SECRET=

# Automated news aggregation (optional). Comma-separated RSS feed URLs —
# each item is imported as a headline + short excerpt with a link back to
# the original source (not republished in full). Leave unset to keep news
# fully admin-authored via /admin/news.
NEWS_RSS_FEEDS=
