# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret checked by /api/cron/sync-sets and /api/cron/sync-news so
# only Vercel Cron (or you) can trigger them. Optional locally; set it in
# Vercel for production.
CRON_SECRET=

# Automated news aggregation (both optional, independent, and can be used
# together). Each imported item is a headline + short excerpt with a link
# back to the original source (not republished in full). Leave both unset
# to keep news fully admin-authored via /admin/news.

# Comma-separated RSS feed URLs you choose (e.g. a Pokémon TCG news site's
# own feed, a subreddit's .rss URL).
NEWS_RSS_FEEDS=

# Set to "true" to also pull from https://press.pokemon.com/en, The
# Pokémon Company's own official press site. It has no RSS feed, so this
# parses its page HTML directly instead.
NEWS_OFFICIAL_PRESS=

# Set to "true" to also pull from https://pokemon.gamespress.com/nl, the
# Dutch/European edition of the same official press site. Also has no
# RSS feed. Independent of NEWS_OFFICIAL_PRESS — enable either, both, or
# neither. Articles are merged into the same global news feed (no
# locale filtering), tagged with a distinct source_name.
NEWS_OFFICIAL_PRESS_NL=
